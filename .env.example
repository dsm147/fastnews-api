# 数据库配置
DATABASE_URL=mysql+aiomysql://your_user:your_password@localhost:3306/news_app?charset=utf8mb4

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 应用配置
DEBUG=True
SECRET_KEY=change-this-to-a-random-string
TOKEN_EXPIRE_DAYS=7

# JWT 配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（生产环境改为具体域名，多个用逗号分隔）
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=10
